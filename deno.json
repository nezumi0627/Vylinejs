{
	"workspace": [
		"./packages/linejs"
	],
	"fmt": {
		"singleQuote": false,
		"useTabs": true,
		"exclude": [
			"./docs/"
		]
	},
	"imports": {
		"@evex/loose-types": "jsr:@evex/loose-types@^1.0.1",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"curve25519-js": "npm:curve25519-js@^0.0.4",
		"node-bignumber": "npm:node-bignumber@^1.2.2",
		"thrift": "npm:thrift@^0.25.0",
		"thrift-types": "npm:@types/thrift@^0.10.17",
		"tweetnacl": "npm:tweetnacl@^1.0.3",
		"jsdom": "npm:jsdom@25.0.0",
		"node-types": "npm:@types/node@^26.6.5",
		"node-int64": "npm:node-int64@^0.4.0"
	},
	"nodeModulesDir": "auto",
	"compilerOptions": {
		"types": ["node-types"]
	},
	"tasks": {
		"dev": "deno run -A --watch sandbox/main.ts",
		"thrift": "deno run --allow-read --allow-write scripts/thrift/tool.ts",
		"thrift:sync-idl": "deno run -A scripts/thrift/sync_thrift.ts",
		"apk:sync": "deno run -A scripts/apk/sync_from_apk.ts",
		"apk:decompile": "deno run -A scripts/apk/decompile.ts",
		"apk:extract-thrift": "deno run -A scripts/apk/extract_thrift.ts",
		"apk:extract-services": "deno run -A scripts/apk/extract_services.ts"
	},
	"unstable": [
		"byonm"
	]
}
